# Supabase - Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenEHR Database (Tibbna) - PostgreSQL connection for patient data
OPENEHR_DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# EHRbase Configuration (if using EHRbase server)
# EHRBASE_URL=https://base.tibbna.com
# EHRBASE_USER=your-username
# EHRBASE_PASSWORD=your-password
# EHRBASE_API_KEY=your-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Staff accounts are provisioned in the Tibbna platform and often have no
# password here, so Google is the practical way in. Signing in with Google
# never creates an account or grants facility access — the email must already
# exist in `users` with a `workspaceusers` row.
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and register these redirect URIs on it:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-production-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the callback URL cannot be derived from the request host.
# GOOGLE_REDIRECT_URI=

# Enables the legacy demo logins (superadmin/finance/hr/inventory/reception),
# which have no users row and therefore no password to check. Leave unset to
# keep them disabled.
DEMO_LOGIN_PASSWORD=

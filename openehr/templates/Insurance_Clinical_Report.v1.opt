                                </occurrences>
                                <node_id></node_id>
                                <item xsi:type="C_STRING">
                                    <list>Medications</list>
                                </item>
                            </children>
                        </attributes>
                    </children>
                </attributes>
                <archetype_id>
                    <value>openEHR-EHR-SECTION.adhoc.v1</value>
